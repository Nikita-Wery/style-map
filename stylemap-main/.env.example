# Copy to .env. All values below are fake; never commit real credentials.
DB_NAME=stylemap
DB_USER=stylemap
DB_PASSWORD=replace-with-your-local-database-password

# Nonempty fake OAuth values permit startup; Google login needs a real client.
GOOGLE_CLIENT_ID=fake-google-client-id
GOOGLE_CLIENT_SECRET=fake-google-client-secret

# Default-on delivery. Set false only for local verification; confirmation is still required.
APP_MAIL_ENABLED=true

# Registration sends a confirmation email: replace these for working mail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=fake-user@example.invalid
MAIL_PASSWORD=fake-mail-application-password
MAIL_SENDER_EMAIL=fake-user@example.invalid

# Optional development SQL diagnostics.
SHOW_SQL=false
