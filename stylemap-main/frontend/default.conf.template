# Шаблон конфига nginx.
# Официальный образ nginx при старте контейнера прогоняет его через envsubst
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) и кладёт результат
# в /etc/nginx/conf.d/default.conf.
#
# Подставляются ТОЛЬКО переменные STYLEMAP_*, поэтому встроенные переменные
# nginx ($host, $http_host, $uri, $scheme, ...) остаются нетронутыми.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Фото/видео до 100 МБ (см. spring.servlet.multipart.max-file-size).
    client_max_body_size 110M;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # DNS для динамического определения адреса бэкенда.
    #   docker-compose : 127.0.0.11                              (встроенный DNS Docker)
    #   kubernetes     : kube-dns.kube-system.svc.cluster.local  (CoreDNS)
    resolver ${STYLEMAP_DNS_RESOLVER} valid=10s ipv6=off;

    # Хешированные ассеты Vite можно кешировать агрессивно.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --- Проксирование на Spring Boot ---------------------------------------------
    # API, аутентификация, загруженные файлы и OAuth2 идут через тот же origin,
    # поэтому сессионная cookie и CSRF-токен работают без CORS.
    #
    # ВАЖНО для Kubernetes: nginx НЕ применяет search-домены из /etc/resolv.conf,
    # поэтому короткое имя сервиса ("back-service") не резолвится — нужно
    # указывать полное имя: back-service.<namespace>.svc.cluster.local
    location ~ ^/(api|auth|uploads|oauth2|login/oauth2)/ {
        set $backend "${STYLEMAP_BACKEND_HOST}";
        proxy_pass http://$backend;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # $http_host (а не $host) — чтобы сохранить внешний порт, например localhost:3000
        # или <node-ip>:30080. Spring использует это для построения redirect_uri в OAuth2.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /favicon.ico {
        set $backend_favicon "${STYLEMAP_BACKEND_HOST}";
        proxy_pass http://$backend_favicon;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # --- SPA ------------------------------------------------------------------------
    # Любой прочий путь отдаёт index.html, чтобы маршрут обработал клиентский роутер.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
