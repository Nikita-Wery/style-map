# Скопируйте в .env.local для локальной разработки.

# Куда Vite dev-сервер проксирует запросы к API.
# По умолчанию http://localhost:8080 (Spring Boot, запущенный локально).
VITE_PROXY_TARGET=http://localhost:8080

# База для запросов из браузера. Оставьте пустым при работе через прокси
# (Vite в dev, nginx в production) — тогда запросы идут на тот же origin.
# VITE_API_BASE_URL=http://localhost:8080
