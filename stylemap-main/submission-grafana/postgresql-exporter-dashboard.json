    {
      "id": 2,
      "title": "PostgreSQL connection health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "description": "pg_up — связь exporter с БД; не только scrape health.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{kubernetes_namespace=\"stylemap\",kubernetes_pod_name=\"postgres-0\",job=\"kubernetes-pods\"}",
          "legendFormat": "PostgreSQL connection health",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Current fetch data",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "description": "Адаптация dashboard 9628 r8. Kubernetes scope вместо Helm release; metrics проверены по live exporter. Counters используют rate; настройки и gauges — напрямую.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_tup_fetched{datname=~\"${database:regex}\", kubernetes_namespace=\"stylemap\",kubernetes_pod_name=\"postgres-0\",job=\"kubernetes-pods\"}[$__rate_interval]))",
          "legendFormat": "Current fetch data",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
