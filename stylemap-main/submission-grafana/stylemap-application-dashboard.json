      "id": 14,
      "title": "JVM heap utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "description": "Heap utilization по pod; max<=0 даёт Нет данных. Визуальные пороги, не SLO.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
