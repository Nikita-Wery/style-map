      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "description": "MVC route templates. UNKNOWN включает запросы, отклонённые до MVC; они не исключаются.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
