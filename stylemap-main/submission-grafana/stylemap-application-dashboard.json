{
  "id": null,
  "uid": null,
  "title": "StyleMap - Application Overview",
  "version": 1,
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "stylemap",
    "homework",
    "RED",
    "USE"
  ],
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Application health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Backend scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "description": "0: хотя бы один обнаруженный target недоступен; 1: все обнаруженные UP. Исчезнувший target не учитывается; пусто — неизвестно.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"})",
          "legendFormat": "Backend scrape health",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Blackbox readiness",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "description": "Readiness backend, включая db; не frontend/Ingress. Нет данных не равно UP.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"stylemap-readiness\",instance=\"http://backend-management.stylemap.svc.cluster.local:8081/actuator/health/readiness\"}",
          "legendFormat": "Blackbox readiness",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP RPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "description": "Скорость завершённых запросов; пусто — нет серии, 0 — наблюдаемый нулевой трафик.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval]))",
          "legendFormat": "HTTP RPS",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 5xx percentage",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "description": "Нет трафика: Нет данных. Если общий counter существует, отсутствие 5xx-серии означает отсутствие записанных 5xx. Пороги 1/5% — визуальные, не SLA.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Нет данных",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval])) > 0)",
          "legendFormat": "HTTP 5xx percentage",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "RED / Golden Signals",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Request rate by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "description": "Traffic и errors; все статусы, включая отклонённые Security запросы. Легенда — HTTP status.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "title": "HTTP errors: 4xx / 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "description": "Ошибки в запросах/с; fallback 0 применяется только при наблюдаемом общем трафике, не при отсутствии метрик.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
