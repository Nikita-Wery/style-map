          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\",status=~\"4..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval]))))",
          "legendFormat": "4xx",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false,
          "interval": "15s",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval]))))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 9,
      "title": "Average HTTP latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "description": "Взвешенное среднее: rate(sum)/rate(count). При нулевом трафике нет значения.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval])) / (sum(rate(http_server_requests_seconds_count{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\"}[$__rate_interval])) > 0)",
          "legendFormat": "Average HTTP latency",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false,
          "interval": "15s",
          "editorMode": "code"
        }
      ]
