        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (kubernetes_pod_name) (jvm_memory_used_bytes{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\",area=\"heap\"}) / (sum by (kubernetes_pod_name) (jvm_memory_max_bytes{app=\"backend\",kubernetes_namespace=\"stylemap\",job=\"kubernetes-pods\",area=\"heap\"}) > 0)",
